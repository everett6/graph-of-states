{
  "model": "google/gemma-4-12B-it-qat-q4_0-unquantized",
  "model_revision": null,
  "output_dir": "runs/gemma-gos-grpo",
  "sources": [
    {
      "name": "stratos",
      "repo": "bespokelabs/Bespoke-Stratos-17k",
      "split": "train",
      "weight": 2
    },
    {
      "name": "fable",
      "repo": "MoreThought/Fable-5.1-Max-Reasoning-Filtered-10000x",
      "split": "full",
      "weight": 1
    },
    {
      "name": "feedback",
      "repo": "m-a-p/CodeFeedback-Filtered-Instruction",
      "split": "train",
      "weight": 1
    }
  ],
  "max_seq_length": 4096,
  "max_prompt_tokens": 3072,
  "max_completion_tokens": 1024,
  "overlap": 256,
  "graph_width": 128,
  "graph_nodes": 4,
  "graph_rounds": 12,
  "logits_chunk_size": 32,
  "gradient_accumulation_steps": 8,
  "learning_rate": 0.0002,
  "max_steps": 1000,
  "eval_steps": 100,
  "save_steps": 100,
  "eval_samples": 128,
  "grpo_generations": 4,
  "critic_weight": 0.1,
  "gpu_memory_fraction": 0.9,
  "seed": 17,
  "reward_function": "train_unified:exact_answer_reward",
  "graph_enhancements": {
    "scratchpad": true,
    "latent_slots": 4,
    "thermal": true,
    "min_rounds": 2,
    "temperature": 1.5,
    "temperature_floor": 0.75,
    "entropy_tolerance": 0.01,
    "motion_tolerance": 0.01,
    "cross_modal": true,
    "branches": true,
    "async_branches": false,
    "dual_friction": true,
    "tool_gate": true
  },
  "inference_cache": "h2o",
  "h2o_heavy_tokens": 256,
  "h2o_recent_tokens": 256,
  "kv_quantization": "int4",
  "kv_kernel": "triton",
  "attention_backend": "sdpa",
  "checkpoint_backend": "torch",
  "checkpoint_cpu_offload": false,
  "coherence_weight": 0.1,
  "tool_gate_weight": 0.1
}
